# Secrets - NEVER commit plaintext
*.env
.env.*
secrets/
*secret*
*password*
*token*
kubeconfig
*.key
*.pem
*.crt
*credentials*
age.key

# Allow example/template files, SOPS-encrypted files, and ArgoCD placeholders (safe to commit)
!*.example.yaml
!*.example.env
!*.sops.yaml
!*secret-placeholder*
!*sops-prune*

# System
.DS_Store
*.log
tmp/
.cache/

# Terraform
*.tfstate
*.tfstate.backup
.terraform/
homelab-clone

todos.md

# Claude — keep memory and local settings private, expose agents only
.claude/*
!.claude/agents/

# SOPS age private key
*.agekey
.config/sops/age/keys.txt
sops/age/keys.txt
