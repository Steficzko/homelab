[Unit]
Description=Whisper GPU Server (PyTorch ROCm + large-v3 + diarization)
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/whisper-gpu.env
WorkingDirectory=/opt/whisper-gpu
ExecStart=/opt/whisper-gpu/bin/python /opt/whisper-gpu/server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
