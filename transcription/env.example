# Copy to /etc/transcribe-watch.env on the Debian VM and adjust as needed.

WATCH_DIR=/mnt/dictaphones
WHISPER_MODEL=large-v3
WHISPER_TIMEOUT=7200

# Active: ryzen-ml CPU (LXC 111) -- large-v3 int8, diarization, always-on, onboot=1
WHISPER_URL=http://192.168.1.225:8000/v1/audio/transcriptions

# Sleeper: whisper-gpu (LXC 112) -- GPU ROCm, no diarization, onboot=0, start manually
# WHISPER_URL=http://192.168.1.226:8000/v1/audio/transcriptions
# WHISPER_HEALTH_URL=http://192.168.1.226:8000/health
# PVE_SSH=root@192.168.1.122
# LXC_ID=112
