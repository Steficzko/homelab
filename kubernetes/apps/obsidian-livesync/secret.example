# CouchDB credentials
# DO NOT commit real values — this shows structure only.
# In production: encrypt with SOPS+Age and commit as secret.sops.yaml
#
# Generate secure values with:
#   openssl rand -base64 32   (for password and secret)
#
# Create the real secret:
#   kubectl create secret generic couchdb-secret \
#     --from-literal=adminUsername=admin \
#     --from-literal=adminPassword=<GENERATED_PASSWORD> \
#     --from-literal=cookieAuthSecret=<GENERATED_SECRET> \
#     -n obsidian-livesync
apiVersion: v1
kind: Secret
metadata:
  name: couchdb-secret
  namespace: obsidian-livesync
type: Opaque
stringData:
  adminUsername: admin
  adminPassword: REPLACE_WITH_STRONG_PASSWORD
  cookieAuthSecret: REPLACE_WITH_RANDOM_SECRET
